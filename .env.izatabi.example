# Gemini API Key (required for agent and backend)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (required for travel planner maps integration)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# JWT Secret for secure user sessions (production fallback is provided but custom is recommended)
JWT_SECRET=your_secure_jwt_secret_change_me
