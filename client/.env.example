# Frontend environment variables for Vite
# Copy to .env.local and fill in values as needed

# Google Maps JavaScript API key (public)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for vector basemap and Advanced Markers
# Create a Map Style in Google Cloud Console and put the Map ID here
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: Enable Advanced Markers when a Map ID is provided
# true|false (default false)
VITE_ENABLE_ADVANCED_MARKER=false
