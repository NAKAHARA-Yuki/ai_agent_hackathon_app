[Unit]
Description=Izatabi Backend Flask Server
After=network.target

[Service]
Type=simple
User=nakahara
WorkingDirectory=/home/nakahara/03_ai_agent_hackathon_app/server
EnvironmentFile=/home/nakahara/.env.izatabi
Environment=FLASK_ENV=production PORT=8080 AGENT_BASE_URL=http://localhost:8082
ExecStart=/home/nakahara/03_ai_agent_hackathon_app/.venv/bin/gunicorn --workers 2 --threads 8 --bind 0.0.0.0:8080 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
